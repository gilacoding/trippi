# Copy this file to backend/.env and fill in your Supabase project values.
# Get them from Supabase Dashboard → Settings → API.
# The anon key is safe for client use (all access is gated by Row Level Security).

TRIPPI_SUPABASE_URL=https://your-project-ref.supabase.co
TRIPPI_SUPABASE_ANON=your-anon-public-key
